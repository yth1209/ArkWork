    "@types/pg": "8.23.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tsx": "4.23.15",
